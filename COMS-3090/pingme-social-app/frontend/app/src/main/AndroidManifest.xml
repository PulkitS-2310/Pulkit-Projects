<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.androidexample">

    <!-- Allow HTTP calls -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Required on Android 13+ to post notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidExample">

        <!-- Firebase default channel for incoming messages -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="default" />

        <!-- 1) Entry point: launch LoginActivity first -->
        <activity
            android:name=".LoginSignUp.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- 2) Sign-up screen (only reachable from LoginActivity) -->
        <activity
            android:name=".LoginSignUp.SignupActivity"
            android:exported="false"/>

        <!-- 3) Welcome page (after login/sign-up) -->
        <activity
            android:name=".WelcomePage.WelcomeActivity"
            android:exported="false"/>

        <!-- 4) Main “tabs”/bottom-nav host -->
        <activity
            android:name=".MainActivity"
            android:exported="false"/>

        <!-- 5) Post search screen (if you still need this separate Activity) -->
        <activity
            android:name=".Search.PostSearchActivity"
            android:exported="false"/>

        <!-- 6) (Optional) your WebSocket demo activity -->
        <activity
            android:name=".ActivityWebSocket"
            android:exported="false"/>

        <!-- 7) Background WebSocket service -->
        <service
            android:name=".WebSocketService"
            android:exported="false"/>

        <!-- 8) Firebase Messaging service for push notifications -->
        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false"
            android:permission="com.google.android.c2dm.permission.SEND"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>

    </application>
</manifest>
